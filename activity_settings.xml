<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Settings"
        android:textColor="#E8D5FF"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Claude API Key"
        android:textColor="#9B7FCC"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_api_key"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_input"
        android:hint="sk-ant-..."
        android:hintTextColor="#555570"
        android:textColor="#E8D5FF"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔑 Anthropic Console से API Key लें: console.anthropic.com"
        android:textColor="#666688"
        android:textSize="12sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="💾 Save करें"
        android:backgroundTint="#7B5FBF"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="← वापस जाएं"
        android:backgroundTint="#1E1E2E"
        android:textColor="#9B7FCC"
        android:textSize="16sp" />

</LinearLayout>
